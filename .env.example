# Copie para .env e ajuste. Não compartilhe o .env (contém a senha do servidor OpenCode).
# Caminhos Windows podem usar \ ou / (o parser não interpreta escapes).

PROJECT_ROOT=C:\Users\Felipe\.gemini\antigravity\scratch\afk-evolution-simulator

# ---------------- Orquestrador
ORCH_HOST=127.0.0.1
ORCH_PORT=8787
# ORCH_PUBLIC_URL=http://127.0.0.1:8787
# ORCH_DB_PATH=orchestrator.db
# ORCH_MOCK_AGENTS=false

# ---------------- DeepSeek via OpenCode 2.x
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Só enviado se o modelo listar a variante em /api/model (low | high | max):
OPENCODE_VARIANT=high
# Agente do OpenCode para implementar (deve existir em /api/agent; Build pode editar arquivos):
OPENCODE_AGENT=Build
# Agente somente leitura para planejar/revisar/responder atribuição (deve existir em /api/agent):
OPENCODE_REVIEW_AGENT=Plan
OPENCODE_TIMEOUT_SECONDS=1800
OPENCODE_QUOTA_COOLDOWN_MINUTES=60
OPENCODE_REQUIRE_VERIFIED_ROUTES=true
# OPENCODE_ROUTES_FILE=config/opencode_routes.json

# ---------------- Gemini via Antigravity CLI
AGY_BIN=agy
AGY_MODEL=gemini-4-argon-high
AGY_EFFORT=
# AGY_EFFORT_FLAG=
AGY_TIMEOUT_SECONDS=1200
AGY_PROMPT_MODE=auto
AGY_RESUME_CONVERSATIONS=auto
# AGY_RESUME_FLAG=
# --mode usado nas skills somente leitura (planejar/revisar). Vazio = não passa --mode.
AGY_REVIEW_MODE=plan
# --mode usado ao implementar. Vazio = comportamento padrão do agy (o comando que você validou).
AGY_IMPLEMENT_MODE=
AGY_QUOTA_COOLDOWN_MINUTES=60

# ---------------- Fluxo
MAX_REVIEW_CYCLES=2
MAX_SUBTASKS=5
MAX_PARALLEL_SUBTASKS=1
PARALLEL_EXECUTION=false
PARALLEL_PER_AGENT=1
# DEPENDENCY_POLICY_FILE=config/dependency_policy.json
ALLOW_AGENT_FALLBACK=false
FINAL_REVIEW=true
A2A_TASK_TIMEOUT_SECONDS=3600
FILE_LOCK_TTL_SECONDS=3600
FILE_LOCK_WAIT_SECONDS=60

# ---------------- Papéis simétricos (v0.4)
MAX_CHECK_FIX_ATTEMPTS=2
MAX_IMPLEMENTATION_ATTEMPTS=4
MAX_BLOCKED_SUBTASKS=3
# false = pula a chamada de aceite/contestação (economiza 1 chamada por workflow)
ASSIGNMENT_NEGOTIATION=true
# ASSIGNMENT_RULES_FILE=config/assignment_rules.json
# CHECKS_FILE=config/checks.json

# ---------------- Contexto e MCP
CONTEXT_MAX_CHARS=40000
# CONTEXT_SOURCES_FILE=config/context_sources.json
# MCP_CONFIG_FILE=config/mcp_servers.json

